#!/bin/sh /etc/rc.common
# VeloCloud Edge 520/540: bring the two 88E6176 switches up as plain
# 4-port switches behind eth0 (switch A) and eth1 (switch B), or, when
# vc-edge5x0-dsa has handed them to mv88e6xxx, just their CPU links.
# Register sequence taken from the vendor igb_vc.c and verified live:
#  - port 4 SerDes: autoneg off, power up, reset (SMI device 0xf, page 1)
#  - port 4: clear PHYDetect, force MAC 1000/full
#  - internal PHYs 0-3: clear power-down, reset
#  - ports 0-4 -> Forwarding, ports 5/6 (RGMII cross-links) stay Disabled
# Needs mdio-tools + kmod-mdio-netlink and the igb-vc-* buses from the
# patched igb.
START=19

R() { mdio "$B" phy "$1" raw "$2"; }
W() { mdio "$B" phy "$1" raw "$2" "$3"; }
smiw() { W 0x1c 0x19 "$3"; W 0x1c 0x18 $(( 0x9400 | ($1 << 5) | $2 )); }
smir() { W 0x1c 0x18 $(( 0x9800 | ($1 << 5) | $2 )); R 0x1c 0x19; }

switch_up() {
	B="$1"
	id=$(R 0x10 3 2>/dev/null) || return 1
	case "$id" in 0x176*) ;; *) echo "$B: no 88E6176 ($id)"; return 1;; esac

	smiw 0xf 22 1
	v=$(smir 0xf 0)
	smiw 0xf 0 $(( (v | 0x8100) & ~0x1800 ))
	sleep 1
	st=$(R 0x14 0)
	W 0x14 0 $(( st & ~0x1000 ))
	W 0x14 1 0x000e

	for d in 0 1 2 3; do
		smiw $d 22 0
		smiw $d 0 0x9140
	done

	for p in 0 1 2 3 4; do
		a=$(( 0x10 + p )); c=$(R $a 4)
		W $a 4 $(( (c & ~3) | 3 ))
	done
	for p in 5 6; do
		a=$(( 0x10 + p )); c=$(R $a 4)
		W $a 4 $(( c & ~3 ))
	done
	echo "$B: 88E6176 $id up, port4 status $(R 0x14 0)"
}

# DSA mode (vc-edge5x0-dsa loaded with dsa_mask set): mv88e6xxx owns the
# switch and resets it at probe, which drops the forced CPU link on port 4.
# The kernel driver never touches the port-4 SerDes (no phylink without a
# device tree), so re-apply only the CPU-side pieces: SerDes autoneg off /
# power up, PHYDetect off and MAC forced 1000/full on port 4.  User ports,
# PHYs and forwarding state are DSA's business.
cpu_link_up() {
	B="$1"
	st=$(R 0x14 0 2>/dev/null) || return 1
	case "$st" in 0x?[89a-f]??) : ;; *)		# bit 11 = link: SerDes needs the full sequence
		smiw 0xf 22 1
		v=$(smir 0xf 0)
		smiw 0xf 0 $(( (v | 0x8100) & ~0x1800 ))
		sleep 1
		st=$(R 0x14 0);;
	esac
	W 0x14 0 $(( st & ~0x1000 ))
	W 0x14 1 0x000e
	echo "$B: DSA CPU link, port4 status $(R 0x14 0)"
}

dsa_managed() {		# mdio device at SMI address 0 exists = handed to mv88e6xxx
	[ -e "/sys/bus/mdio_bus/devices/$1:00" ]
}

# WAN RJ45 (ge1/ge2): two 88E1514 PHYs on the bit-bang bus gpio-0, held in
# reset by PCA9557@0x18 pin 4 (input at power-on).  Instantiate the expander
# on the i2c-gpio adapter the glue registers, pulse the reset, then re-probe
# the two igb functions that deferred/failed at boot.
wan_up() {
	[ -d /sys/bus/i2c/devices/i2c-9 ] || { echo "i2c-9 (i2c-gpio) missing"; return 1; }
	[ -d /sys/bus/i2c/devices/9-0018 ] || echo pca9557 0x18 > /sys/bus/i2c/devices/i2c-9/new_device
	sleep 1
	base=""
	for c in /sys/class/gpio/gpiochip*; do
		[ "$(cat $c/label 2>/dev/null)" = "9-0018" ] && base=${c#*gpiochip}
	done
	[ -n "$base" ] || { echo "pca9557 gpiochip missing"; return 1; }
	# Already bound (script re-run at runtime): pulsing the PHY reset under a
	# bound igb leaves the MAC at "speed unknown" with a hung Tx unit.  Skip
	# the reset, just refresh the LED registers.
	if [ -e /sys/bus/pci/drivers/igb/0000:00:14.2 ] && [ -e /sys/bus/pci/drivers/igb/0000:00:14.3 ]; then
		wan_leds
		echo "wan PHYs already up, reset skipped"
		return 0
	fi
	g=$(( base + 4 ))
	[ -d /sys/class/gpio/gpio$g ] || echo $g > /sys/class/gpio/export
	echo out > /sys/class/gpio/gpio$g/direction
	echo 0 > /sys/class/gpio/gpio$g/value
	sleep 1
	echo 1 > /sys/class/gpio/gpio$g/value
	sleep 1
	for f in 0000:00:14.2 0000:00:14.3; do
		[ -e /sys/bus/pci/drivers/igb/$f ] || echo $f > /sys/bus/pci/drivers/igb/bind 2>/dev/null
	done
	wan_leds
	echo "wan PHY reset done, gpio-0: $(mdio gpio-0 phy 0 raw 2) $(mdio gpio-0 phy 1 raw 2)"
}

# LED wiring on this board (vendor igb_vc_setup_m88e1514): page 3,
# LED[0] = gigabit link, LED[1] = 10/100 link + activity.  The PHY
# default leaves both solid on.  Survives the PHY soft reset igb does.
wan_leds() {
	for a in 0 1; do
		mdio gpio-0 phy $a raw 22 3
		mdio gpio-0 phy $a raw 16 0x0817
		mdio gpio-0 phy $a raw 17 0x0005
		mdio gpio-0 phy $a raw 22 0
	done
}

# Fan: Microchip EMC2104 at 0x2f on the same bus, PWM 100% at power-on.
# The vendor programs its RPM lookup table, but the fan here gives the chip
# no tach signal, so the table makes it pulse; the curve now lives in
# /usr/sbin/velo5x0-fand (velo5x0-fan service).  This only enables PWM
# control: 26 kHz PWM, open-loop mode, and the PCA9557@0x1c pins.
fan_up() {
	[ -d /sys/bus/i2c/devices/i2c-9 ] || return 1
	[ "$(i2cget -y 9 0x2f 0xfd 2>/dev/null)" = "0x1d" ] || { echo "no EMC2104 at 0x2f"; return 1; }
	E() { i2cset -y 9 0x2f "$1" "$2"; }
	E 0x50 0x00
	E 0x42 0x10
	E 0x2b 0x0c
	E 0x41 0x01
	# cut the BIOS 100%-duty boot scream: park the fan at ~30% until
	# velo5x0-fan (START=20) takes over with the real curve
	E 0x40 0x30
	# PCA9557@0x1c pin 6 (FORCE_PWM) high, pin 7 (FORCE_12V) low: the raw
	# 26 kHz PWM reaches the fan's PWM pin. Strap-sweep verified (2026-09):
	# pin6 low routes the drive through the board's chopper (fan sees chopped
	# 12V, speed barely tracks duty); pin6 high gives true proportional PWM
	# (duty 4%..100% -> ~2.4k..11k RPM). Pins 0/1 are PoE: never touch them.
	[ -d /sys/bus/i2c/devices/9-001c ] || echo pca9557 0x1c > /sys/bus/i2c/devices/i2c-9/new_device
	sleep 1
	b2=""
	for c in /sys/class/gpio/gpiochip*; do
		[ "$(cat $c/label 2>/dev/null)" = "9-001c" ] && b2=${c#*gpiochip}
	done
	if [ -n "$b2" ]; then
		for p in 6 7; do
			g=$(( b2 + p ))
			[ -d /sys/class/gpio/gpio$g ] || echo $g > /sys/class/gpio/export
			echo out > /sys/class/gpio/gpio$g/direction
			echo $(( 7 - p )) > /sys/class/gpio/gpio$g/value
		done
	fi
	echo "fan: EMC2104 in PWM mode, temps $(i2cget -y 9 0x2f 0)/$(i2cget -y 9 0x2f 2)/$(i2cget -y 9 0x2f 4)/$(i2cget -y 9 0x2f 6) C"
}

# Front logo RGB LED: the glue hands the PCA9634 at 0x54 to leds-pca963x
# (/sys/class/leds/pca963x:{red,green,blue}:logo, configure in LuCI or /etc/config/system).
# coreboot leaves the outputs disabled: enable them (SoC GPIO 39 = gpio-ich 551,
# active low).
led_up() {
	[ -d /sys/class/gpio/gpio551 ] || echo 551 > /sys/class/gpio/export
	echo out > /sys/class/gpio/gpio551/direction
	echo 0 > /sys/class/gpio/gpio551/value
}

start() {
	[ -x /usr/bin/mdio ] || { echo "mdio-tools missing"; return 1; }
	# USB modem on the TI xHCI.  The SuperSpeed link used to reset constantly
	# (RM520N-GL: 12 resets, every connect failed), so we forced the modem onto
	# the USB2 side.  The cause was USB3 link power management: with U1/U2
	# refused on the port there are 0 resets idle and 0 under load, and the
	# modem runs at 5 Gbps (119 Mbps down vs 104 on USB2).
	#
	# uci velo5x0.@cell[0].ss_lpm_off names the SuperSpeed port to refuse U1/U2
	# on, e.g. '3-0:1.0/usb3-port1'.  Set it, and leave ss_disable unset.
	# ss_disable is still honoured as the fallback if a board turns out to need
	# it, but note that network.wwan.device must then name the usb1 path: the
	# modem's sysfs path changes with the bus it enumerates on.
	sslpm=$(uci -q get velo5x0.@cell[0].ss_lpm_off)
	[ -n "$sslpm" ] && [ -w "/sys/bus/usb/devices/usb3/$sslpm/usb3_lpm_permit" ] && echo 0 > "/sys/bus/usb/devices/usb3/$sslpm/usb3_lpm_permit" && echo "usb: U1/U2 refused on $sslpm (SuperSpeed stays up)"
	ssd=$(uci -q get velo5x0.@cell[0].ss_disable)
	[ -n "$ssd" ] && [ -e "/sys/bus/usb/devices/usb3/$ssd/disable" ] && echo 1 > "/sys/bus/usb/devices/usb3/$ssd/disable" && echo "usb: SuperSpeed disabled on $ssd (modem falls back to USB2)"
	# DSA mode from /etc/config/velo5x0: hand the switches to mv88e6xxx now,
	# so netifd finds lan1..lan8 when it brings br-lan up.
	P=/sys/module/vc_edge5x0_dsa/parameters/dsa_mask
	want=$(uci -q get velo5x0.@dsa[0].mask); want=${want:-0}
	if [ -w "$P" ] && [ "$(cat $P)" != "$want" ]; then
		echo "$want" > "$P" && echo "dsa_mask -> $want"
		sleep 3
	fi
	for B in /sys/class/mdio_bus/igb-vc-*; do
		[ -e "$B" ] || continue
		if dsa_managed "$(basename "$B")"; then
			cpu_link_up "$(basename "$B")"
		else
			switch_up "$(basename "$B")"
		fi
	done
	wan_up
	fan_up
	led_up
}
