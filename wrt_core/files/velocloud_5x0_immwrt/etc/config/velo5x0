# Per-unit settings, preserved across sysupgrade.
# memmap: RAM pages to keep out of use (see /etc/init.d/velo5x0-memmap), e.g.
#   list reserve '4K$0x21bb4a000'
config memmap

# The fan section is initialized and managed by luci-app-velo5x0-fan.

# dsa: 0 = two dumb switches (eth0/eth1), 3 = DSA for both (lan1..lan8); see velo5x0-dsa
# 520V 完美固件: DSA per-port by default — each jack is its own netdev.
config dsa
	option mask '3'

# witness: reachability probes + paging (see velo5x0-witness); fill in a token to page
config witness
	option period '30'
	option fails '3'
	option pushover_token ''
	option pushover_user ''
	option ntfy_url ''
	list target 'internet=1.1.1.1'

# cell: cellular failover (velo5x0-cell); bands for the optional band lock
config cell
	option locked '0'
	option ss_lpm_off '3-0:1.0/usb3-port1'   # refuse USB3 U1/U2 so the modem runs at 5 Gbps (see velo5x0-switch)
	# option ss_disable '3-0:1.0/usb3-port1'  # fallback: force the modem onto USB2 instead
