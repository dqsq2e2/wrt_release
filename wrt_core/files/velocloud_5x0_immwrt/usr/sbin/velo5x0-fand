#!/bin/sh
# VeloCloud Edge 5x0 fan control: software closed loop on the EMC2104 tach.
# 520V 完美固件 edition: one config serves 2-wire, 3-wire and 4-wire fans.
#
# The fan is a 4-pin PWM unit.  With PCA9557@0x1c pin 6 (FORCE_PWM) high and
# pin 7 (FORCE_12V) low the chip's 26 kHz PWM reaches the fan's PWM pin and
# its tach is readable (in the vendor's both-high state the tach reads
# 0xfff8, which made the vendor RPM table spin-up every 15 s).  The chip's
# own RPM algorithm did not converge on this fan, so the loop is here: each
# period the duty moves one step toward the temperature-derived target RPM;
# a tach of 0 with duty > 0 is a stall and gets a spin-up kick.
#
# Fan-type support:
#   4-wire (PWM+tach): closed loop, quiet low end (~1200 RPM).
#   3-wire (tach but high floor): closed loop too, but it stalls below
#     ~2700-2900 RPM, so at startup a floor calibration walks the duty down
#     until the fan nearly stops and lifts min_rpm to the learned floor.
#   2-wire (no tach): open-loop duty curve min_duty..255 over t_min..t_max.
#
# Tunables in /etc/config/velo5x0:
#   config fan
#       option min_rpm '1200'  # quiet-fan preference; raised to the learned floor
#       option max_rpm '6000'  # beyond reach of any 50mm fan: t_max = duty 100%
#       option t_min   '45'    # 45°C start spinning
#       option t_max   '60'    # 60°C full speed
#       option period  '3'
#       option off_below '42'  # >0: stop the fan at/below this C (hysteresis
#       option on_above  '45'  #     vs t_min so it does not flap at the threshold)
#       option tach      'auto' # auto | 0: 0 = 2-wire fan, open-loop duty curve
#       option min_duty  '45'   # open-loop duty at or below t_min (2-wire fans)
#       option temp_src  'emc'   # emc = EMC2104's three diodes (default)
#                                # cpu = coretemp only (fan follows the CPU alone)
BUS=9; ADDR=0x2f
u() { v=$(uci -q get velo5x0.@fan[0].$1); echo "${v:-$2}"; }
min_rpm=$(u min_rpm 1200); max_rpm=$(u max_rpm 6000); tmin=$(u t_min 45); tmax=$(u t_max 60); period=$(u period 3); off_below=$(u off_below 42); on_above=$(u on_above 45); fan_off=0; tach=$(u tach auto); min_duty=$(u min_duty 45); temp_src=$(u temp_src emc); notach=0
E() { i2cset -y $BUS $ADDR "$1" "$2"; }
G() { i2cget -y $BUS $ADDR "$1" 2>/dev/null; }

[ "$(G 0xfd)" = "0x1d" ] || { logger -t velo5x0-fand "no EMC2104 at $ADDR"; exit 1; }
b2=""; for c in /sys/class/gpio/gpiochip*; do [ "$(cat $c/label 2>/dev/null)" = "9-001c" ] && b2=${c#*gpiochip}; done
if [ -n "$b2" ]; then
	for p in 6 7; do g=$(( b2 + p )); [ -d /sys/class/gpio/gpio$g ] || echo $g > /sys/class/gpio/export; echo out > /sys/class/gpio/gpio$g/direction; done
	echo 1 > /sys/class/gpio/gpio$(( b2 + 6 ))/value	# FORCE_PWM high
	echo 0 > /sys/class/gpio/gpio$(( b2 + 7 ))/value	# FORCE_12V low
fi
E 0x50 0x00	# lookup table off
E 0x2b 0x0c	# PWM base 26 kHz
E 0x41 0x01	# divider 1
E 0x42 0x10	# open-loop PWM: the loop below owns the drive

read_rpm() {	# -1 = read failed, 0 = no tach pulses, else RPM
	hi=$(G 0x4e); lo=$(G 0x4f); [ -n "$hi" ] && [ -n "$lo" ] || { echo -1; return; }
	t=$(( $(printf %d "$hi") * 256 + $(printf %d "$lo") ))
	[ $t -ge 65528 ] && echo 0 || echo $(( 3932160 / (t >> 3) ))
}
# resume from the last duty we set (procd restart passes through stop, which
# forces full speed as a fail-safe; without this every config change spikes)
duty=$(cat /tmp/velo5x0-fan.duty 2>/dev/null); duty=${duty:-$(printf %d "$(G 0x40)")}
[ "$duty" -lt 11 ] && duty=12; [ "$duty" -gt 255 ] && duty=255
E 0x40 $duty
n=0; zeros=0
[ "$tach" = 0 ] && notach=1
if [ "$tach" = auto ]; then	# probe: a spinning fan with no tach line reads 0xfff8 forever
	E 0x40 0x80; sleep 4; i=0; while [ $i -lt 4 ]; do [ "$(read_rpm)" -gt 0 ] && break; sleep 1; i=$((i+1)); done
	[ $i -ge 4 ] && notach=1
	E 0x40 $duty
fi
[ $notach -eq 1 ] && logger -t velo5x0-fand "no tach signal: open-loop duty curve ${min_duty}..255"

# one-time floor calibration (3-wire support): walk the duty down until the
# fan nearly stalls; the lowest sustained RPM becomes the effective min_rpm.
# 4-wire fans bottom out near the configured min_rpm, so this is a no-op there.
if [ $notach -eq 0 ]; then
	E 0x40 0xff; sleep 3
	d=249; floor_rpm=0
	while [ $d -gt 11 ]; do
		E 0x40 $d; sleep 2
		r=$(read_rpm)
		[ "$r" -lt 0 ] && break			# i2c hiccup: keep config
		[ "$r" -lt 700 ] && break			# (near-)stall: floor found
		floor_rpm=$r
		d=$(( d - 6 ))
	done
	E 0x40 0x80; sleep 2; duty=$(printf %d "$(G 0x40)")
	if [ "$floor_rpm" -gt 0 ]; then
		learn=$(( floor_rpm + 300 ))
		if [ "$learn" -gt "$min_rpm" ]; then
			min_rpm=$learn
			logger -t velo5x0-fand "floor calibration: fan sustains ~${floor_rpm} RPM min, min_rpm -> ${min_rpm} (3-wire floor)"
		else
			logger -t velo5x0-fand "floor calibration: fan sustains ~${floor_rpm} RPM min, keeping min_rpm ${min_rpm} (4-wire)"
		fi
	fi
fi
while :; do
	temp=0
	if [ "$temp_src" = cpu ]; then			# follow the CPU (coretemp) only
		for h in /sys/class/hwmon/hwmon*; do
			[ "$(cat $h/name 2>/dev/null)" = coretemp ] || continue
			for t in $h/temp*_input; do
				v=$(cat $t 2>/dev/null) || continue
				[ "$v" -gt "$temp" ] && temp=$v
			done
		done
		temp=$(( temp / 1000 ))
	else
		for r in 0x00 0x02 0x04; do
			v=$(printf %d "$(G $r)" 2>/dev/null) || continue
			[ "$v" -gt 127 ] && continue
			[ "$v" -gt "$temp" ] && temp=$v
		done
	fi
	if [ "$temp" -le "$tmin" ]; then target=$min_rpm
	elif [ "$temp" -ge "$tmax" ]; then target=$max_rpm
	else target=$(( min_rpm + (max_rpm - min_rpm) * (temp - tmin) / (tmax - tmin) )); fi
	rpm=$(read_rpm)
	if [ $notach -eq 1 ]; then rpm=-1; fi	# never "stalls", never adjusts on tach
	# optional fan-off-at-idle band (needs a tach: the loop below keeps it honest)
	if [ "$off_below" -gt 0 ] && [ "$on_above" -gt "$off_below" ]; then
		if [ $fan_off -eq 0 ] && [ "$temp" -le "$off_below" ]; then
			fan_off=1; E 0x40 0; logger -t velo5x0-fand "temp ${temp}C <= ${off_below}: fan off"
		elif [ $fan_off -eq 1 ] && [ "$temp" -ge "$on_above" ]; then
			fan_off=0; E 0x40 0x30; sleep 2; duty=14; E 0x40 $duty; zeros=0; logger -t velo5x0-fand "temp ${temp}C >= ${on_above}: fan on"
		fi
		if [ $fan_off -eq 1 ]; then echo 0 > /tmp/velo5x0-fan.duty; sleep "$period"; continue; fi
	fi
	if [ $notach -eq 1 ]; then			# 2-wire fan: duty straight from temperature
		if [ "$temp" -le "$tmin" ]; then d=$min_duty
		elif [ "$temp" -ge "$tmax" ]; then d=255
		else d=$(( min_duty + (255 - min_duty) * (temp - tmin) / (tmax - tmin) )); fi
		[ "$d" -ne "$duty" ] && { duty=$d; E 0x40 $duty; }
	elif [ "$rpm" -lt 0 ]; then :			# i2c read failed this round: leave everything alone
	elif [ "$rpm" -eq 0 ]; then			# no tach pulses: only a stall if it persists (3 rounds)
		zeros=$(( zeros + 1 ))
		if [ $zeros -ge 3 ]; then
			E 0x40 0x30; sleep 2; duty=14; E 0x40 $duty; zeros=0; logger -t velo5x0-fand "stall detected, kicked"
		fi
	else
		zeros=0
		err=$(( rpm - target )); step=$(( (err < 0 ? -err : err) / 150 )); [ $step -lt 1 ] && step=1; [ $step -gt 8 ] && step=8
		if [ "$err" -lt -150 ] && [ "$duty" -lt 255 ]; then duty=$(( duty + step )); [ $duty -gt 255 ] && duty=255; E 0x40 $duty
		elif [ "$err" -gt 150 ] && [ "$duty" -gt 11 ]; then duty=$(( duty - step )); [ $duty -lt 11 ] && duty=11; E 0x40 $duty
		fi
	fi
	echo $duty > /tmp/velo5x0-fan.duty
	n=$(( n + 1 ))
	[ $(( n % 20 )) -eq 1 ] && logger -t velo5x0-fand "temp ${temp}C target ${target} rpm ${rpm} duty ${duty}"
	sleep "$period"
done
