@@ -0,0 +1,37 @@
+package server
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+
+	"github.com/istoreos/quickstart/backend/modules/homeconfig"
+	"github.com/istoreos/quickstart/backend/service"
+)
+
+func TestNetworkOnlyRejectsOutOfScopeRequests(t *testing.T) {
+	handler := networkOnly(service.NewServiceBackend(), func(*http.Request) (homeconfig.Access, error) {
+		return homeconfig.Access{Read: true, Write: true}, nil
+	})
+	for _, tc := range []struct {
+		method, path, origin string
+		status               int
+	}{
+		{"GET", "/cgi-bin/luci/istore/network/device/list/", "", http.StatusNotFound},
+		{"GET", "/cgi-bin/luci/istore/guide/gateway-router/", "", http.StatusMethodNotAllowed},
+		{"POST", "/cgi-bin/luci/istore/guide/pppoe/", "https://example.invalid", http.StatusForbidden},
+		{"POST", "/cgi-bin/luci/istore/network/interface/config/", "https://example.invalid", http.StatusForbidden},
+	} {
+		t.Run(tc.method+" "+tc.path, func(t *testing.T) {
+			request := httptest.NewRequest(tc.method, tc.path, strings.NewReader("{}"))
+			request.Header.Set("Content-Type", "application/json")
+			request.Header.Set("Origin", tc.origin)
+			response := httptest.NewRecorder()
+			handler.ServeHTTP(response, request)
+			if response.Code != tc.status {
+				t.Fatalf("status = %d, want %d", response.Code, tc.status)
+			}
+		})
+	}
+}
