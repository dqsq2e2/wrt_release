+package server
+
+import (
+	"net/http"
+	"strings"
+
+	"github.com/istoreos/quickstart/backend/modules/homeconfig"
+	"github.com/istoreos/quickstart/backend/service"
+	"github.com/julienschmidt/httprouter"
+)
+
+func NetworkOnly(backend *service.ServiceBackend) http.Handler {
+	return networkOnly(backend, homeconfig.RootAuthorizer(homeconfig.LocalSession))
+}
+
+func networkOnly(backend *service.ServiceBackend, authorize homeconfig.Authorize) http.Handler {
+	router := httprouter.New()
+	registerNetworkRoutes(router, backend)
+	registerGuideCoreRoutes(router, backend)
+
+	methods := map[string]string{
+		"/network/interface/config/": "GET POST",
+		"/u/network/status/":         "GET",
+		"/guide/pppoe/":              "GET POST",
+		"/guide/client-mode/":        "GET POST",
+		"/guide/lan/":                "GET",
+		"/guide/gateway-router/":     "POST",
+	}
+	return secureHTTP(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		path, found := strings.CutPrefix(r.URL.Path, "/cgi-bin/luci/istore")
+		if !found || methods[path] == "" {
+			http.NotFound(w, r)
+			return
+		}
+		allowed := methods[path]
+		if !strings.Contains(" "+allowed+" ", " "+r.Method+" ") {
+			w.Header().Set("Allow", allowed)
+			w.WriteHeader(http.StatusMethodNotAllowed)
+			return
+		}
+		router.ServeHTTP(w, r)
+	}), authorize)
+}
