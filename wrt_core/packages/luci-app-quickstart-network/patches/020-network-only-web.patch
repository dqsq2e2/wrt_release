diff --git a/web/src/plugins/router/network-only.ts b/web/src/plugins/router/network-only.ts
new file mode 100644
index 0000000..0190888
--- /dev/null
+++ b/web/src/plugins/router/network-only.ts
@@ -0,0 +1,22 @@
+import { createRouter, createWebHistory } from "vue-router"
+import NetworkPage from "/@/pages/network/index.vue"
+import NetworkHome from "/@/pages/network/index/index.vue"
+import Pppoe from "/@/pages/network/pppoe/index.vue"
+import Dhcp from "/@/pages/network/dhcp/index.vue"
+import Gateway from "/@/pages/network/gateway/index.vue"
+import InterfaceConfig from "/@/pages/interfaceconfig/index.vue"
+
+const guide = window.vue_base.endsWith("/pages/")
+export const router = createRouter({
+    history: createWebHistory(window.vue_base),
+    routes: guide ? [{ path: "/", redirect: "/network" }, {
+        path: "/network",
+        component: NetworkPage,
+        children: [
+            { path: "", component: NetworkHome },
+            { path: "pppoe", component: Pppoe },
+            { path: "dhcp", component: Dhcp },
+            { path: "gateway", component: Gateway },
+        ],
+    }] : [{ path: "/interfaceconfig", component: InterfaceConfig }],
+})
diff --git a/web/src/style/network-vantage.css b/web/src/style/network-vantage.css
new file mode 100644
index 0000000..230faf6
--- /dev/null
+++ b/web/src/style/network-vantage.css
@@ -0,0 +1,171 @@
+.qs-network #app #page :is(.title, .desc) {
+    background: transparent;
+    box-shadow: none;
+}
+
+.qs-network #app #page .title {
+    color: var(--text);
+}
+
+.qs-network #app #page :is(.desc, .info, .network-message li) {
+    color: var(--text-2);
+}
+
+.qs-network #app #page a {
+    color: var(--accent-text);
+}
+
+.qs-network #app #page :is(.msgs, .msg, .network-message li span) {
+    color: var(--err-text);
+}
+
+.qs-network #app #page code {
+    background: var(--s2);
+    color: var(--text-2);
+}
+
+.qs-network .qs-ports-title {
+    margin: 0 0 12px;
+    background: transparent;
+    box-shadow: none;
+    color: var(--text);
+}
+
+.qs-ports-scroll {
+    max-width: 100%;
+    overflow-x: auto;
+    border: 1px solid var(--line-2);
+    border-radius: var(--r-lg, 8px);
+    background: var(--s1);
+}
+
+.qs-network .qs-port-matrix {
+    --qs-interface-width: 135px;
+    --qs-port-min: 88px;
+    margin: 0;
+    width: 100%;
+    min-width: calc(var(--qs-interface-width) + var(--qs-port-count) * var(--qs-port-min));
+    table-layout: fixed;
+    border-collapse: separate;
+    border-spacing: 0;
+    color: var(--text);
+    background: var(--s1);
+}
+
+.qs-network .qs-port-matrix :is(th, td) {
+    padding: 7px 6px;
+    text-align: center;
+    vertical-align: middle;
+    border-bottom: 1px solid var(--line);
+}
+
+.qs-network .qs-port-matrix thead th {
+    height: 58px;
+    background: var(--s2);
+    font-weight: 600;
+}
+
+.qs-network .qs-port-matrix .qs-fixed {
+    position: sticky;
+    left: 0;
+    z-index: 1;
+    width: var(--qs-interface-width);
+    padding-inline: 10px;
+    text-align: left;
+    background: var(--s1);
+    border-right: 1px solid var(--line);
+}
+
+.qs-network .qs-port-matrix thead .qs-fixed {
+    background: var(--s2);
+}
+
+.qs-port-id,
+.qs-interface-name {
+    display: flex;
+    align-items: center;
+    flex-wrap: wrap;
+    gap: 3px 6px;
+    overflow-wrap: anywhere;
+}
+
+.qs-port-id {
+    justify-content: center;
+    font-size: var(--fs-base, 13px);
+}
+
+.qs-port-state {
+    width: 6px;
+    height: 6px;
+    flex: 0 0 6px;
+    border-radius: 50%;
+    background: var(--line-2);
+}
+
+.qs-port-state.is-up {
+    background: var(--ok);
+}
+
+.qs-port-speed,
+.qs-interface-name small {
+    color: var(--text-2);
+    font-size: var(--fs-micro, 11px);
+    font-weight: 500;
+    overflow-wrap: anywhere;
+}
+
+.qs-interface-name small {
+    font-family: var(--mono);
+}
+
+.qs-interface-actions {
+    display: flex;
+    gap: 4px;
+    margin-top: 4px;
+}
+
+.qs-network .qs-port-matrix :is(.qs-interface-actions, .qs-add-interface) button.cbi-button {
+    min-height: 26px;
+    height: auto;
+    margin: 0;
+    padding: 2px 7px;
+    font-size: var(--fs-sm, 12px);
+    white-space: nowrap;
+}
+
+.qs-network .qs-port-matrix tbody tr:hover td,
+.qs-network .qs-port-matrix tbody tr:hover th,
+.qs-network .qs-port-matrix tbody .qs-add-interface > td {
+    background: var(--s2);
+}
+
+.qs-network .qs-port-matrix tbody:last-child tr:last-child > td {
+    border-bottom: none;
+}
+
+@media (max-width: 600px) {
+    .qs-network .qs-port-matrix {
+        --qs-interface-width: 108px;
+        --qs-port-min: 76px;
+    }
+    .qs-network .qs-port-matrix .qs-fixed {
+        padding-inline: 7px;
+    }
+}
+
+.qs-network #actioner .actioner-dns {
+    color: var(--text);
+    background: var(--s2);
+}
+
+.qs-network #actioner :is(.actioner-dns_header, .actioner-dns_footer) {
+    border-color: var(--line);
+}
+
+.qs-network #actioner .label-item_key {
+    color: var(--text-2);
+}
+
+.qs-network #actioner .label-message {
+    color: var(--err-text);
+}
