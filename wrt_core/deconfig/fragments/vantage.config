# Vantage theme, dashboard and NetWiz. Runtime dependencies are in their Makefiles.
CONFIG_PACKAGE_luci-theme-vantage=y
CONFIG_PACKAGE_luci-app-vantage=y
CONFIG_PACKAGE_luci-app-netwiz=y
CONFIG_PACKAGE_luci-theme-aurora=y
CONFIG_PACKAGE_luci-app-aurora-config=y
CONFIG_PACKAGE_luci-i18n-aurora-config-zh-cn=y
